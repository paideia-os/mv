// src/move.pdx -- mv.M2-001 (paideia-os/mv#4)
//
// Move module: cross-directory same-device move (link-unlink atomic
// in TXN). This is the general mv operation for the M2 shape --
// `mv <src> <dst>` where src and dst may share a parent (same-dir
// rename degenerate case) OR live under different parents on the
// same device (cross-directory move).
//
// =============================================================================
// SCOPE
// =============================================================================
//
// mv M2-001 is the plan doc §5.7 M2 line's first landing:
//
//   "Cross-directory move (same device -- single TXN)"
//
// Sequence:
//
//   (1) pdxfs_resolve_parent(src) -> (src_parent_inode, src_basename_ptr).
//       Sub-step of "walk the mv-supplied src path to its dirent
//       parent + basename". src_parent stored in mv_move_src_parent;
//       src_basename in mv_move_src_basename.
//   (2) pdxfs_resolve_parent(dst) -> (dst_parent_inode, dst_basename_ptr).
//   (3) pdxfs_inode_of(src) -> src_inode. The inode that the link
//       call will re-attach under dst_basename.
//   (4) pdxfs_txn_open(PXT_MODE_MODIFY, 0) -> txn_handle. Fresh
//       KIND_PDXFS_TXN in the caller's cap_table.
//   (5) pdxfs_unlink(txn, src_parent, src_basename). Buffered in
//       the TXN's WAL group; not durable until commit.
//   (6) pdxfs_link(txn, dst_parent, dst_basename, src_inode). Same
//       TXN.
//   (7) pdxfs_txn_commit(txn). Both dirent writes durable atomically.
//   (8) Bump MV_ST_MOVES + MV_ST_CROSS_DIR (if src_parent != dst_parent).
//   (9) Return 0.
//
// Every error path calls pdxfs_txn_abort to unwind whatever partial
// state got threaded into the TXN, bumps MV_ST_ERRORS +
// MV_ST_TXN_ABORTS, and returns a distinct MV_MV_* code so a
// downstream test can identify which stage failed.
//
// =============================================================================
// SAME-DIR VS CROSS-DIR
// =============================================================================
//
// move_dispatch handles BOTH cases -- same-dir rename is the
// degenerate case where src_parent == dst_parent. The two dirent
// writes go through the same TXN either way; the only observable
// difference is which stat slot bumps (MV_ST_MOVES always,
// MV_ST_CROSS_DIR only when the parents differ).
//
// The M1 Rename::rename_same_dir is preserved for its argument-gating
// discipline and its MV_RN_STUB sentinel; it is NOT deprecated yet
// (M3-wiring at _start will decide which entry point to call from
// the _start frame).
//
// =============================================================================
// CROSS-DEVICE ROUTE (M2-002)
// =============================================================================
//
// M2-002 will wire an EXDEV fallback: if pdxfs_link returns
// PDXFS_ERR_EXDEV (-18), Move::move_dispatch calls Move::move_cross_dev
// (added at M2-002) which opens src RO, opens dst WRONLY|CREAT,
// byte-copies through a scratch buffer, unlinks src, and commits all
// under the SAME TXN. M2-001 does not implement the EXDEV path --
// it treats EXDEV as a hard-fail MV_MV_LINK_FAIL and lets M2-002
// insert the fallback.
//
// =============================================================================
// PAIDEIA-AS CONFORMANCE
// =============================================================================
//
//   - Module name PascalCase basename (`Move`), no directory prefix.
//   - No `test` mnemonic; every zero-check uses `cmp reg, 0`.
//   - Every `cmp reg, imm` uses imm <= 0x7FFFFFFF.
//   - r11 is scratch (paideia-as reserved) for every .bss reach.
//   - Byte reads not used in this module (path pointers passed as
//     opaque u64; basename byte compare happens in pdxfs_resolve_parent
//     inside the kernel).
//   - SysV push/pop parity: move_dispatch saves rbx, r12, r13, r14, r15
//     across the eight nested Pdxfs::* calls. Prologue is 5 pushes +
//     `sub rsp, 8` for alignment; matching epilogue restores rsp %
//     16 == 8 for the ret. Same idiom as cp's copy_single_file
//     (paideia-os/cp src/copy.pdx).

module Move = structure {

  // ==========================================================================
  // Storage
  //
  // Six .bss slots that live only for the duration of a single
  // move_dispatch call. They are on-stack semantics implemented in
  // .bss because Pdxfs::pdxfs_resolve_parent uses output-pointer
  // arguments (out_parent_inode_ptr, out_basename_ptr) and taking
  // &stack_slot in paideia-as inline asm would need an rsp-relative
  // LEA that varies with the prologue depth; storing to .bss keeps
  // the addressing straightforward at every call site.
  //
  // Single-invocation shape means these are safe as globals -- no
  // re-entrancy at M2 (a mv process runs one dispatch and exits).
  // ==========================================================================
  pub let mut mv_move_src_parent   : u64 = uninit @align(8)
  pub let mut mv_move_src_basename : u64 = uninit @align(8)
  pub let mut mv_move_dst_parent   : u64 = uninit @align(8)
  pub let mut mv_move_dst_basename : u64 = uninit @align(8)
  pub let mut mv_move_src_inode    : u64 = uninit @align(8)
  pub let mut mv_move_txn_handle   : u64 = uninit @align(8)

  // ==========================================================================
  // move_reset() -> ()
  //
  // Clear the six .bss slots so a subsequent move_dispatch starts
  // from a known-zero baseline. Called at the top of move_dispatch.
  // Leaf; r11 scratch.
  // ==========================================================================
  pub let move_reset : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "mv.M2-001 (#4): zero the six move-local .bss slots so move_dispatch starts empty. Same idiom as mv_argv_reset (src/argv.pdx) and cp's CopyFile::copy_reset (paideia-os/cp src/copy.pdx). xor rax,rax; six lea+mov pairs. Leaf function -- no push/pop parity. r11 is scratch (paideia-as conformance).",
      block: {
        xor rax, rax;
        lea r11, [rip + mv_move_src_parent];   mov [r11], rax;
        lea r11, [rip + mv_move_src_basename]; mov [r11], rax;
        lea r11, [rip + mv_move_dst_parent];   mov [r11], rax;
        lea r11, [rip + mv_move_dst_basename]; mov [r11], rax;
        lea r11, [rip + mv_move_src_inode];    mov [r11], rax;
        lea r11, [rip + mv_move_txn_handle];   mov [r11], rax;
        ret
      }
    }

  // ==========================================================================
  // move_dispatch(src_ptr, dst_ptr) -> u64
  //
  // The general mv operation. Handles both same-directory rename
  // (src_parent == dst_parent) and cross-directory move
  // (src_parent != dst_parent). Both cases go through ONE PdxFS TXN.
  //
  // RDI (input): src_ptr -- NUL-terminated source path (caller-owned)
  // RSI (input): dst_ptr -- NUL-terminated destination path (caller-owned)
  // RAX (output): 0 on success; MV_MV_* on any error.
  //
  // Register plan (nested Pdxfs::* calls):
  //   rbx = src_ptr           (preserved across every call)
  //   r12 = dst_ptr           (preserved across every call)
  //   r13 = src_parent inode  (preserved across every call after step 1)
  //   r14 = dst_parent inode  (preserved across every call after step 2)
  //   r15 = txn handle        (preserved across every call after step 4)
  //   rax = call return / bump-arg scratch
  //   rdi/rsi/rdx/rcx = SysV args to nested calls
  //   r11 = LEA scratch (paideia-as reserved)
  //
  // Prologue: 5 callee-save pushes (rbx, r12, r13, r14, r15) = 40
  // bytes. Entry rsp % 16 == 8; 5 pushes land rsp % 16 == 0 (each
  // push flips the parity so odd-count push runs land back at 0).
  // No `sub rsp, 8` needed -- 5 pushes is the odd-alignment idiom.
  // Compare cp's copy_single_file (5 pushes, no sub) vs M1's
  // rename_same_dir (2 pushes + sub 8 = even-alignment idiom).
  // Matching 5-pop epilogue.
  // ==========================================================================
  pub let move_dispatch : (u64, u64) -> u64 !{mem, sysreg} @{cap, sched} =
    fn (src_ptr: u64) (dst_ptr: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap, sched},
      justification: "mv.M2-001 (#4): move_dispatch general-mv entry point. Threads unlink+link through a single Pdxfs TXN so both dirent writes land atomically (D3 audit-first, I5 undo -- half-completed moves are the class of bug PdxFS v1 exists to eliminate). Prologue is 5 callee-save pushes (rbx=src_ptr, r12=dst_ptr, r13=src_parent, r14=dst_parent, r15=txn_handle) = 40 bytes; entry rsp % 16 == 8 + 5 pushes lands rsp % 16 == 0 without needing a stack-pad sub (odd-count push idiom same as cp's copy_single_file; contrast M1 rename_same_dir which uses the even-count 2-push + sub 8 idiom). Eight nested Pdxfs::* SysV calls (resolve x2, inode_of, txn_open, unlink, link, txn_commit, and possibly txn_abort on error). Matching 5-pop epilogue restores rsp for the ret. Every zero/error compare uses `cmp reg, 0` (no test mnemonic; imm 0 fits imm32). Bump discipline: MV_ST_INVOCATIONS on entry, MV_ST_TXN_OPENS after txn_open success, MV_ST_TXN_COMMITS on commit success, MV_ST_TXN_ABORTS + MV_ST_ERRORS + explicit pdxfs_txn_abort on any post-open failure, MV_ST_MOVES on overall success, MV_ST_CROSS_DIR when src_parent != dst_parent. Every error path returns a distinct MV_MV_* code from the 0xFFFFEB3x band (STUB/RESOLVE_FAIL/INODE_FAIL/TXN_OPEN_FAIL/UNLINK_FAIL/LINK_FAIL/COMMIT_FAIL) so a downstream test identifies which stage failed. All Pdxfs::* trampolines are M2 stubs returning 0 (or 1 for handle-returning ones); the R42 substrate landing swaps their bodies without touching this dispatcher. Effects: !{mem, sysreg} for the syscall-clobber shape (mem via kernel WAL writes; sysreg via the syscall rcx/r11 clobber); @{cap} because pdxfs_txn_open mints a fresh KIND_PDXFS_TXN into the caller's cap_table; @{sched} because commit may block on the WAL drain group and the scheduler is entitled to preempt. Labels prefixed mv_md_.",
      block: {
        // ---- Prologue ---------------------------------------------------------
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov rbx, rdi;                        // rbx = src_ptr
        mov r12, rsi;                        // r12 = dst_ptr

        // ---- Bump MV_ST_INVOCATIONS ------------------------------------------
        mov rdi, 0;                          // MV_ST_INVOCATIONS
        call mv_note;

        // ---- Reset move-local slots ------------------------------------------
        call move_reset;

        // ---- Step 1: resolve src parent + basename ---------------------------
        mov rdi, rbx;                        // path
        lea rsi, [rip + mv_move_src_parent];   // out_parent_inode_ptr
        lea rdx, [rip + mv_move_src_basename]; // out_basename_ptr
        call pdxfs_resolve_parent;
        cmp rax, 0;
        jne mv_md_resolve_src_fail;

        // Load src_parent into r13 (preserved across subsequent calls).
        lea r11, [rip + mv_move_src_parent];
        mov r13, [r11];

        // ---- Step 2: resolve dst parent + basename ---------------------------
        mov rdi, r12;                        // path = dst_ptr
        lea rsi, [rip + mv_move_dst_parent];
        lea rdx, [rip + mv_move_dst_basename];
        call pdxfs_resolve_parent;
        cmp rax, 0;
        jne mv_md_resolve_dst_fail;

        // Load dst_parent into r14.
        lea r11, [rip + mv_move_dst_parent];
        mov r14, [r11];

        // ---- Step 3: fetch src inode -----------------------------------------
        mov rdi, rbx;                        // src_ptr
        call pdxfs_inode_of;
        cmp rax, 0;
        jl  mv_md_inode_fail;                // negative errno
        je  mv_md_inode_fail;                // 0 handle also invalid

        // Store src_inode.
        lea r11, [rip + mv_move_src_inode];
        mov [r11], rax;

        // ---- Step 4: open TXN ------------------------------------------------
        mov rdi, 2;                          // PXT_MODE_MODIFY
        mov rsi, 0;                          // snap_gen = 0 (current)
        call pdxfs_txn_open;
        cmp rax, 0;
        jl  mv_md_txn_open_fail;             // negative errno
        je  mv_md_txn_open_fail;             // 0 handle also invalid

        mov r15, rax;                        // r15 = txn handle
        lea r11, [rip + mv_move_txn_handle];
        mov [r11], rax;

        // Bump MV_ST_TXN_OPENS on successful open.
        mov rdi, 2;                          // MV_ST_TXN_OPENS
        call mv_note;

        // ---- Step 5: unlink src dirent (in TXN) -----------------------------
        mov rdi, r15;                        // txn
        mov rsi, r13;                        // src_parent
        lea r11, [rip + mv_move_src_basename];
        mov rdx, [r11];                      // src_basename
        call pdxfs_unlink;
        cmp rax, 0;
        jne mv_md_unlink_fail;

        // ---- Step 6: link dst dirent (in same TXN) --------------------------
        mov rdi, r15;                        // txn
        mov rsi, r14;                        // dst_parent
        lea r11, [rip + mv_move_dst_basename];
        mov rdx, [r11];                      // dst_basename
        lea r11, [rip + mv_move_src_inode];
        mov rcx, [r11];                      // src_inode
        call pdxfs_link;
        cmp rax, 0;
        jne mv_md_link_fail;

        // ---- Step 7: commit TXN ---------------------------------------------
        mov rdi, r15;                        // txn
        call pdxfs_txn_commit;
        cmp rax, 0;
        jne mv_md_commit_fail;

        // Bump MV_ST_TXN_COMMITS + MV_ST_MOVES.
        mov rdi, 3;                          // MV_ST_TXN_COMMITS
        call mv_note;
        mov rdi, 1;                          // MV_ST_MOVES (== MV_ST_RENAMES slot)
        call mv_note;

        // Bump MV_ST_CROSS_DIR if src_parent != dst_parent.
        cmp r13, r14;
        je  mv_md_success;
        mov rdi, 6;                          // MV_ST_CROSS_DIR
        call mv_note;

      mv_md_success:
        xor rax, rax;                        // MV_OK
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret;

      mv_md_resolve_src_fail:
        mov rdi, 5;                          // MV_ST_ERRORS
        call mv_note;
        mov rax, 0xFFFFEB31;                 // MV_MV_RESOLVE_SRC_FAIL
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret;

      mv_md_resolve_dst_fail:
        mov rdi, 5;
        call mv_note;
        mov rax, 0xFFFFEB32;                 // MV_MV_RESOLVE_DST_FAIL
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret;

      mv_md_inode_fail:
        mov rdi, 5;
        call mv_note;
        mov rax, 0xFFFFEB33;                 // MV_MV_INODE_FAIL
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret;

      mv_md_txn_open_fail:
        mov rdi, 5;
        call mv_note;
        mov rax, 0xFFFFEB34;                 // MV_MV_TXN_OPEN_FAIL
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret;

      mv_md_unlink_fail:
        // TXN is open with no writes threaded -- abort to release the
        // handle, then return the failure code.
        mov rdi, r15;
        call pdxfs_txn_abort;
        mov rdi, 4;                          // MV_ST_TXN_ABORTS
        call mv_note;
        mov rdi, 5;                          // MV_ST_ERRORS
        call mv_note;
        mov rax, 0xFFFFEB35;                 // MV_MV_UNLINK_FAIL
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret;

      mv_md_link_fail:
        // TXN has the unlink threaded -- abort discards the WAL group
        // so the source dirent is preserved.
        mov rdi, r15;
        call pdxfs_txn_abort;
        mov rdi, 4;
        call mv_note;
        mov rdi, 5;
        call mv_note;
        mov rax, 0xFFFFEB36;                 // MV_MV_LINK_FAIL
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret;

      mv_md_commit_fail:
        // commit failed -- the kernel already moved the TXN to
        // ABORTED so no user-side abort call needed; the caller sees
        // no state change (source keeps its old name, dest never
        // appeared).
        mov rdi, 4;
        call mv_note;
        mov rdi, 5;
        call mv_note;
        mov rax, 0xFFFFEB37;                 // MV_MV_COMMIT_FAIL
        add rsp, 8;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
