// src/move.pdx -- mv.M2-001 (paideia-os/mv#4)
//
// Move module: cross-directory same-device move (link-unlink atomic
// in TXN). This is the general mv operation for the M2 shape --
// `mv <src> <dst>` where src and dst may share a parent (same-dir
// rename degenerate case) OR live under different parents on the
// same device (cross-directory move).
//
// =============================================================================
// SCOPE
// =============================================================================
//
// mv M2-001 is the plan doc §5.7 M2 line's first landing:
//
//   "Cross-directory move (same device -- single TXN)"
//
// Sequence:
//
//   (1) pdxfs_resolve_parent(src) -> (src_parent_inode, src_basename_ptr).
//       Sub-step of "walk the mv-supplied src path to its dirent
//       parent + basename". src_parent stored in mv_move_src_parent;
//       src_basename in mv_move_src_basename.
//   (2) pdxfs_resolve_parent(dst) -> (dst_parent_inode, dst_basename_ptr).
//   (3) pdxfs_inode_of(src) -> src_inode. The inode that the link
//       call will re-attach under dst_basename.
//   (4) pdxfs_txn_open(PXT_MODE_MODIFY, 0) -> txn_handle. Fresh
//       KIND_PDXFS_TXN in the caller's cap_table.
//   (5) pdxfs_unlink(txn, src_parent, src_basename). Buffered in
//       the TXN's WAL group; not durable until commit.
//   (6) pdxfs_link(txn, dst_parent, dst_basename, src_inode). Same
//       TXN.
//   (7) pdxfs_txn_commit(txn). Both dirent writes durable atomically.
//   (8) Bump MV_ST_MOVES + MV_ST_CROSS_DIR (if src_parent != dst_parent).
//   (9) Return 0.
//
// Every error path calls pdxfs_txn_abort to unwind whatever partial
// state got threaded into the TXN, bumps MV_ST_ERRORS +
// MV_ST_TXN_ABORTS, and returns a distinct MV_MV_* code so a
// downstream test can identify which stage failed.
//
// =============================================================================
// SAME-DIR VS CROSS-DIR
// =============================================================================
//
// move_dispatch handles BOTH cases -- same-dir rename is the
// degenerate case where src_parent == dst_parent. The two dirent
// writes go through the same TXN either way; the only observable
// difference is which stat slot bumps (MV_ST_MOVES always,
// MV_ST_CROSS_DIR only when the parents differ).
//
// The M1 Rename::rename_same_dir is preserved for its argument-gating
// discipline and its MV_RN_STUB sentinel; it is NOT deprecated yet
// (M3-wiring at _start will decide which entry point to call from
// the _start frame).
//
// =============================================================================
// CROSS-DEVICE ROUTE (M2-002)
// =============================================================================
//
// M2-002 will wire an EXDEV fallback: if pdxfs_link returns
// PDXFS_ERR_EXDEV (-18), Move::move_dispatch calls Move::move_cross_dev
// (added at M2-002) which opens src RO, opens dst WRONLY|CREAT,
// byte-copies through a scratch buffer, unlinks src, and commits all
// under the SAME TXN. M2-001 does not implement the EXDEV path --
// it treats EXDEV as a hard-fail MV_MV_LINK_FAIL and lets M2-002
// insert the fallback.
//
// =============================================================================
// PAIDEIA-AS CONFORMANCE
// =============================================================================
//
//   - Module name PascalCase basename (`Move`), no directory prefix.
//   - No `test` mnemonic; every zero-check uses `cmp reg, 0`.
//   - Every `cmp reg, imm` uses imm <= 0x7FFFFFFF.
//   - r11 is scratch (paideia-as reserved) for every .bss reach.
//   - Byte reads not used in this module (path pointers passed as
//     opaque u64; basename byte compare happens in pdxfs_resolve_parent
//     inside the kernel).
//   - SysV push/pop parity: move_dispatch saves rbx, r12, r13, r14, r15
//     across the eight nested Pdxfs::* calls. Prologue is 5 pushes +
//     `sub rsp, 8` for alignment; matching epilogue restores rsp %
//     16 == 8 for the ret. Same idiom as cp's copy_single_file
//     (paideia-os/cp src/copy.pdx).

module Move = structure {

  // ==========================================================================
  // Storage
  //
  // Six .bss slots that live only for the duration of a single
  // move_dispatch call. They are on-stack semantics implemented in
  // .bss because Pdxfs::pdxfs_resolve_parent uses output-pointer
  // arguments (out_parent_inode_ptr, out_basename_ptr) and taking
  // &stack_slot in paideia-as inline asm would need an rsp-relative
  // LEA that varies with the prologue depth; storing to .bss keeps
  // the addressing straightforward at every call site.
  //
  // Single-invocation shape means these are safe as globals -- no
  // re-entrancy at M2 (a mv process runs one dispatch and exits).
  // ==========================================================================
  pub let mut mv_move_src_parent   : u64 = uninit @align(8)
  pub let mut mv_move_src_basename : u64 = uninit @align(8)
  pub let mut mv_move_dst_parent   : u64 = uninit @align(8)
  pub let mut mv_move_dst_basename : u64 = uninit @align(8)
  pub let mut mv_move_src_inode    : u64 = uninit @align(8)
  pub let mut mv_move_txn_handle   : u64 = uninit @align(8)

  // -- M2-002 cross-device fallback state -----------------------------------
  //
  // 4 KiB byte-copy scratch, running byte counter, two file descriptor
  // slots. Same footprint as cp's CopyFile::copy_buf / bytes_copied /
  // fd_src / fd_dst. 4 KiB matches the typical page-size fingerprint;
  // amortises the syscall overhead for a small-file-typical workload
  // without pinning excessive .bss.
  pub let MV_XDEV_BUF_LEN : u64 = 4096
  pub let mut mv_move_xdev_buf     : [u8; 4096] = uninit @align(8)
  pub let mut mv_move_xdev_fd_src  : u64        = uninit @align(8)
  pub let mut mv_move_xdev_fd_dst  : u64        = uninit @align(8)
  pub let mut mv_move_xdev_bytes   : u64        = uninit @align(8)

  // -- M2-002 was_cross_device flag ------------------------------------------
  //
  // Set to 1 by move_dispatch when the EXDEV fallback fires. The
  // verbose diagnostic (M2-003) reads this to decide whether to emit
  // the "not O(1)" advisory. Also written to a semantic-pipe record
  // at M3 (MoveRecord.was_cross_device). Cleared in move_reset.
  pub let mut mv_move_was_cross_device : u64 = uninit @align(8)

  // -- Return-code stash slot -----------------------------------------------
  //
  // move_dispatch uses this to preserve the specific MV_MV_XDEV_*
  // return code from move_cross_dev_body across the pdxfs_txn_abort
  // + mv_note calls that follow a fallback failure (nested calls
  // clobber rax). Cheaper + more legible than the push-rax + dummy-
  // push-to-realign-rsp alternative.
  pub let mut mv_move_return_code : u64 = uninit @align(8)

  // ==========================================================================
  // move_reset() -> ()
  //
  // Clear the six .bss slots so a subsequent move_dispatch starts
  // from a known-zero baseline. Called at the top of move_dispatch.
  // Leaf; r11 scratch.
  // ==========================================================================
  pub let move_reset : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "mv.M2-001 (#4) + mv.M2-002 (#5): zero the move-local .bss slots so move_dispatch starts empty. Same idiom as mv_argv_reset (src/argv.pdx) and cp's CopyFile::copy_reset (paideia-os/cp src/copy.pdx). xor rax,rax; ten lea+mov pairs (six M2-001 slots + four M2-002 slots including was_cross_device). Leaf function -- no push/pop parity. r11 is scratch (paideia-as conformance).",
      block: {
        xor rax, rax;
        lea r11, [rip + mv_move_src_parent];        mov [r11], rax;
        lea r11, [rip + mv_move_src_basename];      mov [r11], rax;
        lea r11, [rip + mv_move_dst_parent];        mov [r11], rax;
        lea r11, [rip + mv_move_dst_basename];      mov [r11], rax;
        lea r11, [rip + mv_move_src_inode];         mov [r11], rax;
        lea r11, [rip + mv_move_txn_handle];        mov [r11], rax;
        lea r11, [rip + mv_move_xdev_fd_src];       mov [r11], rax;
        lea r11, [rip + mv_move_xdev_fd_dst];       mov [r11], rax;
        lea r11, [rip + mv_move_xdev_bytes];        mov [r11], rax;
        lea r11, [rip + mv_move_was_cross_device];  mov [r11], rax;
        ret
      }
    }

  // ==========================================================================
  // move_cross_dev_body(src_ptr, dst_ptr) -> u64
  //
  // Cross-device byte-copy fallback for the M2-002 EXDEV case. Called
  // BY move_dispatch after pdxfs_link returns PDXFS_ERR_EXDEV (-18)
  // indicating that source inode and destination parent live on
  // different devices. The move can still complete atomically because
  // the outer TXN (opened by move_dispatch) buffers the destination-
  // device write group + the source-device unlink into ONE WAL scope;
  // pdxfs_txn_commit drains both device groups or neither.
  //
  // The txn handle, src_parent, and src_basename slots are read from
  // the .bss slots move_dispatch already populated (mv_move_txn_handle,
  // mv_move_src_parent, mv_move_src_basename) so this function's arity
  // stays 2 (matches the M1 rename_same_dir arity for reader ergonomics).
  //
  // RDI (input): src_ptr -- NUL-terminated source path
  // RSI (input): dst_ptr -- NUL-terminated destination path
  // RAX (output): 0 on success; MV_MV_XDEV_* on any error.
  //
  // The R42 substrate landing will attach a TXN handle to sys_open so
  // the read/write pair is buffered inside the same TXN scope. Until
  // then the trampolines are plain sys_read / sys_write which is
  // atomicity-equivalent for the single-device case tests exercise;
  // the M4 fixture matrix documents the semantic gap.
  //
  // Sequence:
  //   (1) pdxfs_open(src, O_RDONLY = 0)      -> fd_src.
  //   (2) pdxfs_open(dst, O_WRONLY|O_CREAT = 0x41) -> fd_dst.
  //   (3) Byte-copy loop through mv_move_xdev_buf until EOF (n == 0).
  //       Accumulate bytes into mv_move_xdev_bytes.
  //   (4) pdxfs_close(fd_dst); pdxfs_close(fd_src) (return codes ignored).
  //   (5) pdxfs_unlink(txn, src_parent, src_basename) -- inside the
  //       outer TXN. On failure the caller's abort unwinds the dst
  //       inode as well (the WAL group is discarded).
  //   (6) Return 0.
  //
  // Register plan (nested Pdxfs::* calls):
  //   rbx = src_ptr
  //   r12 = dst_ptr
  //   r13 = fd_src (from pdxfs_open)
  //   r14 = fd_dst (from pdxfs_open)
  //   r15 = n (last read bytes; needed as write len and as short-write cmp)
  //   rax = call return / accumulator scratch
  //   rdi/rsi/rdx = SysV args to nested calls
  //   r11 = LEA scratch (paideia-as reserved)
  //
  // Prologue: 5 callee-save pushes (rbx, r12, r13, r14, r15) = 40 bytes;
  // odd-count push idiom lands rsp % 16 == 0 without needing a stack
  // pad sub. Same idiom as cp CopyFile::copy_single_file and mv's own
  // move_dispatch.
  // ==========================================================================
  pub let move_cross_dev_body : (u64, u64) -> u64 !{mem, sysreg} @{cap, sched} =
    fn (src_ptr: u64) (dst_ptr: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap, sched},
      justification: "mv.M2-002 (#5): move_cross_dev_body -- cp+rm internal fallback for the EXDEV case. Byte-copies through a 4 KiB scratch (mv_move_xdev_buf) via real sys_open/read/write/close (Pdxfs::pdxfs_open etc.); on EOF, closes both fds and unlinks the source dirent inside the outer TXN (via Pdxfs::pdxfs_unlink using the txn handle mv_move_txn_handle plus src_parent/src_basename already resolved by move_dispatch). Both the destination-device write group AND the source-device unlink are buffered in the ONE WAL scope move_dispatch opened; commit drains both or neither (still-single-TXN invariant from plan doc §5.7 M2 line). Prologue is 5 callee-save pushes (rbx=src_ptr, r12=dst_ptr, r13=fd_src, r14=fd_dst, r15=last_n) = 40 bytes; odd-count push lands rsp % 16 == 0 (same idiom as cp copy_single_file, mv move_dispatch). Six error branches (open_src / open_dst / read / write / short_write / unlink) each close whichever fds are open (0/1/2 depending on where the error hit) and return a distinct MV_MV_XDEV_* code from the 0xFFFFEB3[89ABCD] band. Short-write detected by `cmp rax, r15; jl` (signed compare -- rax = bytes_written from sys_write, r15 = requested len; jl fires when bytes_written < requested). Negative-errno detection uses `cmp rax, 0; jl` throughout. Every `cmp reg, imm` uses imm <= 0x7FFFFFFF (0, 0x40, 0x41, 4096 all fit). Register plan documented above; r11 scratch for every .bss reach. Effects match move_dispatch: !{mem, sysreg} for the syscall clobber shape; @{cap} because the outer TXN cap was already minted by move_dispatch (this body only invokes it via pdxfs_unlink -- an @{cap} operation); @{sched} because the byte-copy syscalls may block on device I/O. Labels prefixed mv_mx_.",
      block: {
        // ---- Prologue --------------------------------------------------------
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov rbx, rdi;                        // rbx = src_ptr
        mov r12, rsi;                        // r12 = dst_ptr

        // ---- Step 1: open src (O_RDONLY = 0) --------------------------------
        mov rdi, rbx;                        // path
        mov rsi, 0;                          // O_RDONLY
        call pdxfs_open;
        cmp rax, 0;
        jl  mv_mx_open_src_fail;             // negative errno

        mov r13, rax;                        // r13 = fd_src
        lea r11, [rip + mv_move_xdev_fd_src];
        mov [r11], rax;

        // ---- Step 2: open dst (O_WRONLY | O_CREAT = 0x41) -------------------
        mov rdi, r12;                        // path
        mov rsi, 0x41;                       // O_WRONLY | O_CREAT
        call pdxfs_open;
        cmp rax, 0;
        jl  mv_mx_open_dst_fail;             // negative errno

        mov r14, rax;                        // r14 = fd_dst
        lea r11, [rip + mv_move_xdev_fd_dst];
        mov [r11], rax;

        // ---- Step 3: read/write loop ---------------------------------------
      mv_mx_loop:
        mov rdi, r13;                        // fd_src
        lea rsi, [rip + mv_move_xdev_buf];   // buf
        mov rdx, 4096;                       // MV_XDEV_BUF_LEN
        call pdxfs_read;

        cmp rax, 0;
        jl  mv_mx_read_fail;                 // negative errno
        je  mv_mx_eof;                       // n == 0 -> EOF

        mov r15, rax;                        // r15 = n (bytes read)

        mov rdi, r14;                        // fd_dst
        lea rsi, [rip + mv_move_xdev_buf];
        mov rdx, r15;                        // len = n
        call pdxfs_write;

        cmp rax, 0;
        jl  mv_mx_write_fail;                // negative errno

        cmp rax, r15;
        jl  mv_mx_short_write;               // bytes_written < n

        // Accumulate mv_move_xdev_bytes += rax.
        lea r11, [rip + mv_move_xdev_bytes];
        mov rcx, [r11];
        add rcx, rax;
        mov [r11], rcx;

        jmp mv_mx_loop;

        // ---- Step 4+5: success arm (EOF, close both, unlink src) ------------
      mv_mx_eof:
        // Close dst first, then src. Ignore return codes.
        mov rdi, r14;
        call pdxfs_close;
        mov rdi, r13;
        call pdxfs_close;

        // Step 5: unlink src dirent inside the outer TXN.
        lea r11, [rip + mv_move_txn_handle];
        mov rdi, [r11];
        lea r11, [rip + mv_move_src_parent];
        mov rsi, [r11];
        lea r11, [rip + mv_move_src_basename];
        mov rdx, [r11];
        call pdxfs_unlink;
        cmp rax, 0;
        jne mv_mx_unlink_fail;

        xor rax, rax;                        // MV_OK
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret;

        // ---- Error branches (fds cleaned per-branch) ------------------------
      mv_mx_open_src_fail:
        mov rax, 0xFFFFEB38;                 // MV_MV_XDEV_OPEN_SRC_FAIL
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret;

      mv_mx_open_dst_fail:
        // fd_src is open; close it.
        mov rdi, r13;
        call pdxfs_close;
        mov rax, 0xFFFFEB39;                 // MV_MV_XDEV_OPEN_DST_FAIL
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret;

      mv_mx_read_fail:
        mov rdi, r14;
        call pdxfs_close;
        mov rdi, r13;
        call pdxfs_close;
        mov rax, 0xFFFFEB3A;                 // MV_MV_XDEV_READ_FAIL
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret;

      mv_mx_write_fail:
        mov rdi, r14;
        call pdxfs_close;
        mov rdi, r13;
        call pdxfs_close;
        mov rax, 0xFFFFEB3B;                 // MV_MV_XDEV_WRITE_FAIL
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret;

      mv_mx_short_write:
        mov rdi, r14;
        call pdxfs_close;
        mov rdi, r13;
        call pdxfs_close;
        mov rax, 0xFFFFEB3C;                 // MV_MV_XDEV_SHORT_WRITE
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret;

      mv_mx_unlink_fail:
        // fds already closed on the success arm; nothing to release.
        mov rax, 0xFFFFEB3D;                 // MV_MV_XDEV_UNLINK_FAIL
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  // ==========================================================================
  // move_dispatch(src_ptr, dst_ptr) -> u64
  //
  // The general mv operation. Handles both same-directory rename
  // (src_parent == dst_parent) and cross-directory move
  // (src_parent != dst_parent). Both cases go through ONE PdxFS TXN.
  //
  // RDI (input): src_ptr -- NUL-terminated source path (caller-owned)
  // RSI (input): dst_ptr -- NUL-terminated destination path (caller-owned)
  // RAX (output): 0 on success; MV_MV_* on any error.
  //
  // Register plan (nested Pdxfs::* calls):
  //   rbx = src_ptr           (preserved across every call)
  //   r12 = dst_ptr           (preserved across every call)
  //   r13 = src_parent inode  (preserved across every call after step 1)
  //   r14 = dst_parent inode  (preserved across every call after step 2)
  //   r15 = txn handle        (preserved across every call after step 4)
  //   rax = call return / bump-arg scratch
  //   rdi/rsi/rdx/rcx = SysV args to nested calls
  //   r11 = LEA scratch (paideia-as reserved)
  //
  // Prologue: 5 callee-save pushes (rbx, r12, r13, r14, r15) = 40
  // bytes. Entry rsp % 16 == 8; 5 pushes land rsp % 16 == 0 (each
  // push flips the parity so odd-count push runs land back at 0).
  // No `sub rsp, 8` needed -- 5 pushes is the odd-alignment idiom.
  // Compare cp's copy_single_file (5 pushes, no sub) vs M1's
  // rename_same_dir (2 pushes + sub 8 = even-alignment idiom).
  // Matching 5-pop epilogue.
  // ==========================================================================
  pub let move_dispatch : (u64, u64) -> u64 !{mem, sysreg} @{cap, sched} =
    fn (src_ptr: u64) (dst_ptr: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap, sched},
      justification: "mv.M2-001 (#4): move_dispatch general-mv entry point. Threads unlink+link through a single Pdxfs TXN so both dirent writes land atomically (D3 audit-first, I5 undo -- half-completed moves are the class of bug PdxFS v1 exists to eliminate). Prologue is 5 callee-save pushes (rbx=src_ptr, r12=dst_ptr, r13=src_parent, r14=dst_parent, r15=txn_handle) = 40 bytes; entry rsp % 16 == 8 + 5 pushes lands rsp % 16 == 0 without needing a stack-pad sub (odd-count push idiom same as cp's copy_single_file; contrast M1 rename_same_dir which uses the even-count 2-push + sub 8 idiom). Eight nested Pdxfs::* SysV calls (resolve x2, inode_of, txn_open, unlink, link, txn_commit, and possibly txn_abort on error). Matching 5-pop epilogue restores rsp for the ret. Every zero/error compare uses `cmp reg, 0` (no test mnemonic; imm 0 fits imm32). Bump discipline: MV_ST_INVOCATIONS on entry, MV_ST_TXN_OPENS after txn_open success, MV_ST_TXN_COMMITS on commit success, MV_ST_TXN_ABORTS + MV_ST_ERRORS + explicit pdxfs_txn_abort on any post-open failure, MV_ST_MOVES on overall success, MV_ST_CROSS_DIR when src_parent != dst_parent. Every error path returns a distinct MV_MV_* code from the 0xFFFFEB3x band (STUB/RESOLVE_FAIL/INODE_FAIL/TXN_OPEN_FAIL/UNLINK_FAIL/LINK_FAIL/COMMIT_FAIL) so a downstream test identifies which stage failed. All Pdxfs::* trampolines are M2 stubs returning 0 (or 1 for handle-returning ones); the R42 substrate landing swaps their bodies without touching this dispatcher. Effects: !{mem, sysreg} for the syscall-clobber shape (mem via kernel WAL writes; sysreg via the syscall rcx/r11 clobber); @{cap} because pdxfs_txn_open mints a fresh KIND_PDXFS_TXN into the caller's cap_table; @{sched} because commit may block on the WAL drain group and the scheduler is entitled to preempt. Labels prefixed mv_md_.",
      block: {
        // ---- Prologue ---------------------------------------------------------
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov rbx, rdi;                        // rbx = src_ptr
        mov r12, rsi;                        // r12 = dst_ptr

        // ---- Bump MV_ST_INVOCATIONS ------------------------------------------
        mov rdi, 0;                          // MV_ST_INVOCATIONS
        call mv_note;

        // ---- Reset move-local slots ------------------------------------------
        call move_reset;

        // ---- Step 1: resolve src parent + basename ---------------------------
        mov rdi, rbx;                        // path
        lea rsi, [rip + mv_move_src_parent];   // out_parent_inode_ptr
        lea rdx, [rip + mv_move_src_basename]; // out_basename_ptr
        call pdxfs_resolve_parent;
        cmp rax, 0;
        jne mv_md_resolve_src_fail;

        // Load src_parent into r13 (preserved across subsequent calls).
        lea r11, [rip + mv_move_src_parent];
        mov r13, [r11];

        // ---- Step 2: resolve dst parent + basename ---------------------------
        mov rdi, r12;                        // path = dst_ptr
        lea rsi, [rip + mv_move_dst_parent];
        lea rdx, [rip + mv_move_dst_basename];
        call pdxfs_resolve_parent;
        cmp rax, 0;
        jne mv_md_resolve_dst_fail;

        // Load dst_parent into r14.
        lea r11, [rip + mv_move_dst_parent];
        mov r14, [r11];

        // ---- Step 3: fetch src inode -----------------------------------------
        mov rdi, rbx;                        // src_ptr
        call pdxfs_inode_of;
        cmp rax, 0;
        jl  mv_md_inode_fail;                // negative errno
        je  mv_md_inode_fail;                // 0 handle also invalid

        // Store src_inode.
        lea r11, [rip + mv_move_src_inode];
        mov [r11], rax;

        // ---- Step 4: open TXN ------------------------------------------------
        mov rdi, 2;                          // PXT_MODE_MODIFY
        mov rsi, 0;                          // snap_gen = 0 (current)
        call pdxfs_txn_open;
        cmp rax, 0;
        jl  mv_md_txn_open_fail;             // negative errno
        je  mv_md_txn_open_fail;             // 0 handle also invalid

        mov r15, rax;                        // r15 = txn handle
        lea r11, [rip + mv_move_txn_handle];
        mov [r11], rax;

        // Bump MV_ST_TXN_OPENS on successful open.
        mov rdi, 2;                          // MV_ST_TXN_OPENS
        call mv_note;

        // ---- Step 5: unlink src dirent (in TXN) -----------------------------
        mov rdi, r15;                        // txn
        mov rsi, r13;                        // src_parent
        lea r11, [rip + mv_move_src_basename];
        mov rdx, [r11];                      // src_basename
        call pdxfs_unlink;
        cmp rax, 0;
        jne mv_md_unlink_fail;

        // ---- Step 6: link dst dirent (in same TXN) --------------------------
        mov rdi, r15;                        // txn
        mov rsi, r14;                        // dst_parent
        lea r11, [rip + mv_move_dst_basename];
        mov rdx, [r11];                      // dst_basename
        lea r11, [rip + mv_move_src_inode];
        mov rcx, [r11];                      // src_inode
        call pdxfs_link;
        cmp rax, 0;
        je  mv_md_link_ok;                   // link succeeded, commit path
        // link returned non-zero: is it EXDEV? (M2-002 fallback path)
        // PDXFS_ERR_EXDEV = 0xFFFFFFFFFFFFFFEE (-18). Load into rcx
        // via imm64 mov (paideia-as emits mov r64, imm64) because
        // `cmp rax, imm` requires the immediate to fit in 32 bits
        // and 0xFFFFFFFFFFFFFFEE does not.
        mov rcx, 0xFFFFFFFFFFFFFFEE;
        cmp rax, rcx;
        jne mv_md_link_fail;                 // some other errno -> hard fail

        // ---- Step 6b (M2-002): EXDEV -> byte-copy + unlink fallback ---------
        // Mark the operation as cross-device for the M2-003 diagnostic
        // BEFORE calling move_cross_dev_body so a body-side abort still
        // records the flag (the flag is descriptive, not consequential).
        mov rax, 1;
        lea r11, [rip + mv_move_was_cross_device];
        mov [r11], rax;

        // move_cross_dev_body(src_ptr=rbx, dst_ptr=r12) uses the .bss
        // slots move_dispatch populated (txn, src_parent, src_basename).
        mov rdi, rbx;                        // src_ptr
        mov rsi, r12;                        // dst_ptr
        call move_cross_dev_body;
        cmp rax, 0;
        jne mv_md_xdev_fail;                 // fallback failed -> abort TXN

        // Fallback succeeded -- bump MV_ST_CROSS_DEV and fall into commit.
        mov rdi, 7;                          // MV_ST_CROSS_DEV
        call mv_note;

      mv_md_link_ok:
        // ---- Step 7: commit TXN ---------------------------------------------
        mov rdi, r15;                        // txn
        call pdxfs_txn_commit;
        cmp rax, 0;
        jne mv_md_commit_fail;

        // Bump MV_ST_TXN_COMMITS + MV_ST_MOVES.
        mov rdi, 3;                          // MV_ST_TXN_COMMITS
        call mv_note;
        mov rdi, 1;                          // MV_ST_MOVES (== MV_ST_RENAMES slot)
        call mv_note;

        // Bump MV_ST_CROSS_DIR if src_parent != dst_parent.
        cmp r13, r14;
        je  mv_md_verbose;
        mov rdi, 6;                          // MV_ST_CROSS_DIR
        call mv_note;

      mv_md_verbose:
        // M2-003: emit --verbose diagnostic if flag was set + xdev fired.
        // Best-effort: mv_verbose_diag returns 0 unconditionally and
        // its internal fd-2 write failure does not affect rax here.
        call mv_verbose_diag;

      mv_md_success:
        xor rax, rax;                        // MV_OK
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret;

      mv_md_resolve_src_fail:
        mov rdi, 5;                          // MV_ST_ERRORS
        call mv_note;
        mov rax, 0xFFFFEB31;                 // MV_MV_RESOLVE_SRC_FAIL
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret;

      mv_md_resolve_dst_fail:
        mov rdi, 5;
        call mv_note;
        mov rax, 0xFFFFEB32;                 // MV_MV_RESOLVE_DST_FAIL
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret;

      mv_md_inode_fail:
        mov rdi, 5;
        call mv_note;
        mov rax, 0xFFFFEB33;                 // MV_MV_INODE_FAIL
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret;

      mv_md_txn_open_fail:
        mov rdi, 5;
        call mv_note;
        mov rax, 0xFFFFEB34;                 // MV_MV_TXN_OPEN_FAIL
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret;

      mv_md_unlink_fail:
        // TXN is open with no writes threaded -- abort to release the
        // handle, then return the failure code.
        mov rdi, r15;
        call pdxfs_txn_abort;
        mov rdi, 4;                          // MV_ST_TXN_ABORTS
        call mv_note;
        mov rdi, 5;                          // MV_ST_ERRORS
        call mv_note;
        mov rax, 0xFFFFEB35;                 // MV_MV_UNLINK_FAIL
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret;

      mv_md_link_fail:
        // TXN has the unlink threaded -- abort discards the WAL group
        // so the source dirent is preserved.
        mov rdi, r15;
        call pdxfs_txn_abort;
        mov rdi, 4;
        call mv_note;
        mov rdi, 5;
        call mv_note;
        mov rax, 0xFFFFEB36;                 // MV_MV_LINK_FAIL
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret;

      mv_md_xdev_fail:
        // move_cross_dev_body returned a specific MV_MV_XDEV_* code in
        // rax. Stash it in .bss so it survives the abort + note calls.
        lea r11, [rip + mv_move_return_code];
        mov [r11], rax;
        // TXN has the dst-side writes (if any) threaded -- abort.
        mov rdi, r15;
        call pdxfs_txn_abort;
        mov rdi, 4;                          // MV_ST_TXN_ABORTS
        call mv_note;
        mov rdi, 5;                          // MV_ST_ERRORS
        call mv_note;
        // Restore the specific fallback error code.
        lea r11, [rip + mv_move_return_code];
        mov rax, [r11];
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret;

      mv_md_commit_fail:
        // commit failed -- the kernel already moved the TXN to
        // ABORTED so no user-side abort call needed; the caller sees
        // no state change (source keeps its old name, dest never
        // appeared).
        mov rdi, 4;
        call mv_note;
        mov rdi, 5;
        call mv_note;
        mov rax, 0xFFFFEB37;                 // MV_MV_COMMIT_FAIL
        add rsp, 8;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
